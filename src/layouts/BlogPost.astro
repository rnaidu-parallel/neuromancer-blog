---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, repo, demo } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${title} · blackwall`} description={description} type="article">
  <article>
    <header class="post-header reveal">
      <time class="post-date" datetime={pubDate.toISOString()}>
        {fmt(pubDate)}
        {updatedDate && <span> · updated {fmt(updatedDate)}</span>}
      </time>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        )
      }
      {
        (demo || repo) && (
          <div class="callouts">
            {demo && (
              <a class="demo-callout" href={demo}>
                ▸ play with it — the live demo
              </a>
            )}
            {repo && (
              <a class="repo-callout" href={repo}>
                ▸ reproduce it yourself — the repo
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="prose reveal">
      <slot />
    </div>
  </article>
</Base>
