---
import '../styles/global.css';
import Icon from '../components/Icons.astro';
import LatentField from '../components/LatentField.astro';

interface Props {
  title: string;
  description: string;
  /** og:type, usually "article" for blog posts */
  type?: string;
  /** social-share card; site-root path or absolute URL. Defaults to og-default.png. */
  image?: string;
  /** use the wide content column */
  wide?: boolean;
  /** masthead treatment for the current route */
  masthead?: 'home' | 'compact';
}

const {
  title,
  description,
  type = 'website',
  image,
  wide = false,
  masthead = 'compact',
} = Astro.props;

const pageTitle = title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/images/og-default.png', Astro.site);
const path = Astro.url.pathname;
const compactCrumb =
  path.startsWith('/blog/') && path !== '/blog/'
    ? path.replace(/^\/blog\/|\/$/g, '').toUpperCase()
    : path === '/'
      ? 'HOME'
      : path.replace(/^\/|\/$/g, '').toUpperCase() || 'HOME';
const isHome = masthead === 'home';
const navItems = [
  { href: '/blog/', label: 'posts' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: 'https://neuromancer.in', label: 'token-maxxing', external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Rahul Naidu — a journal of measured work in AI engineering"
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rahul Naidu" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // theme init before paint, no FOUC
      const stored = localStorage.getItem('theme');
      if (stored === 'print') document.documentElement.dataset.theme = 'print';
    </script>
  </head>
  <body>
    <div class="ambient-layer" aria-hidden="true">
      <LatentField />
      <slot name="ambient" />
    </div>

    <div class="page-shell">
      <header class:list={['journal-header', { 'journal-header--compact': !isHome }]}>
        <div class="double-rule" aria-hidden="true"></div>
        <div class="masthead-row">
          <a class="wordmark" href="/" aria-label="Rahul Naidu home">Rahul Naidu</a>
          <span class="seal" aria-hidden="true">
            <Icon name="seal" />
          </span>
        </div>
        {
          isHome ? (
            <>
              <p class="dek">A journal of measured work in AI engineering.</p>
              <p class="dateline">VOL. I · EST. JUNE 2026 · BANGALORE</p>
            </>
          ) : (
            <p class="dateline">VOL. I · {compactCrumb} · BANGALORE</p>
          )
        }
        <div class="double-rule" aria-hidden="true"></div>
        <nav class="journal-nav" aria-label="Main">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={
                  !item.external &&
                  (path === item.href || (item.href !== '/' && path.startsWith(item.href)))
                    ? 'page'
                    : undefined
                }
              >
                <span>{item.label}</span>
                {item.external && <Icon name="external" />}
              </a>
            ))
          }
          <button class="theme-toggle" id="theme-toggle" aria-label="switch to print">
            <Icon name="toggle" title="Theme" />
          </button>
        </nav>
      </header>

      <main class:list={['journal-main', { 'journal-main--wide': wide }]}>
        <slot />
      </main>

      <footer class="colophon">
        <nav class="identity" aria-label="Identity links">
          <a href="https://github.com/rnaidu-parallel" rel="me" aria-label="GitHub">
            <Icon name="github" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/rahul-naidu-siriporam-15472116b/"
            rel="me"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" />
            <span>LinkedIn</span>
          </a>
          <a href="https://x.com/rahulwlw" rel="me" aria-label="X">
            <Icon name="x" />
            <span>X</span>
          </a>
          <a href="mailto:rahulnaidusiriporam@gmail.com" aria-label="Email">
            <Icon name="mail" />
            <span>Mail</span>
          </a>
        </nav>
        <p>AI engineer. Builds and measures LLM systems. Evidence over claims.</p>
        <p>
          Set in Besley and Source Serif 4 · <a href="/rss.xml"><Icon name="rss" /> RSS</a>
        </p>
      </footer>
    </div>

    <script is:inline>
      const button = document.getElementById('theme-toggle');
      const setLabel = () => {
        const next = document.documentElement.dataset.theme === 'print' ? 'paper' : 'print';
        button?.setAttribute('aria-label', `switch to ${next}`);
      };
      setLabel();
      button?.addEventListener('click', () => {
        const root = document.documentElement;
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const next = root.dataset.theme === 'print' ? 'paper' : 'print';
        if (!reducedMotion) root.classList.add('theme-swapping');
        if (next === 'print') root.dataset.theme = 'print';
        else delete root.dataset.theme;
        localStorage.setItem('theme', next);
        setLabel();
        if (!reducedMotion) {
          const clearSwap = () => root.classList.remove('theme-swapping');
          root.addEventListener('transitionend', clearSwap, { once: true });
          setTimeout(clearSwap, 260);
        }
      });
    </script>
  </body>
</html>
