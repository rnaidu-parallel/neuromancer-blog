<canvas class="latent-field-canvas" data-latent-field aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    window.__latentField?.destroy?.();

    const canvas = document.querySelector('[data-latent-field]');
    const ctx = canvas?.getContext?.('2d', { alpha: true });
    if (!canvas || !ctx) return;

    const root = document.documentElement;
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarseQuery = window.matchMedia('(hover: none), (pointer: coarse)');
    const particles = [];
    const color = { r: 191, g: 220, b: 239 };
    const safelight = { r: 224, g: 85, b: 69 };
    const maxClusterParticles = 40;
    const baseCount = 180;
    const mobileCap = 90;
    const calmRatio = 0.6;
    const focusRadius = 180;
    const neighborRadius = 150;
    const gridSize = 90;
    const resizeDelay = 140;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let running = false;
    let animationId = 0;
    let lastFrame = 0;
    let formed = false;
    let hasEntries = false;
    let totalPoints = 0;
    let clusterParticles = 0;
    let condensationStartedAt = 0;
    let condensationCaptured = false;
    let resizeTimer = 0;
    let destroyed = false;
    let initialized = false;
    let focus = { x: 0, y: 0, active: false };

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const easeOut = (t) => 1 - Math.pow(1 - clamp(t, 0, 1), 3);
    const rand = (seed) => {
      const s = Math.sin(seed * 127.1) * 43758.5453;
      return s - Math.floor(s);
    };
    const isPrint = () => root.dataset.theme === 'print';

    function entryRows() {
      return Array.from(document.querySelectorAll('.entries .entry'));
    }

    function particleCount() {
      const mobile = document.documentElement.clientWidth <= 760;
      const rows = entryRows();
      const fullCount = mobile ? mobileCap : baseCount;
      return {
        rows,
        count: rows.length > 0 ? fullCount : Math.floor(fullCount * calmRatio),
      };
    }

    function resizeCanvas() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = document.documentElement.clientWidth;
      height = document.documentElement.clientHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function initParticles() {
      const { rows, count } = particleCount();
      hasEntries = rows.length > 0;
      totalPoints = count;
      clusterParticles = hasEntries ? Math.min(maxClusterParticles, count) : 0;
      particles.length = 0;
      formed = false;
      condensationCaptured = false;

      for (let i = 0; i < totalPoints; i += 1) {
        const x = rand(i + 11) * width;
        const y = rand(i + 29) * height;
        particles.push({
          x,
          y,
          startX: x,
          startY: y,
          vx: (rand(i + 41) - 0.5) * 0.15,
          vy: (rand(i + 53) - 0.5) * 0.15,
          seed: rand(i + 67) * 1000,
          targetX: x,
          targetY: y,
          cluster: i < clusterParticles ? i % rows.length : -1,
          driftPhase: rand(i + 79) * Math.PI * 2,
        });
      }

      assignClusterTargets();
      condensationStartedAt = performance.now() + 1200;
    }

    function assignClusterTargets() {
      const rows = entryRows();
      if (!rows.length) {
        hasEntries = false;
        particles.forEach((p) => {
          p.cluster = -1;
        });
        return;
      }

      hasEntries = true;
      particles.forEach((p, index) => {
        if (index >= clusterParticles) return;
        const rowIndex = index % rows.length;
        const rect = rows[rowIndex].getBoundingClientRect();
        const slot = Math.floor(index / rows.length);
        const angle = (slot / 7) * Math.PI * 2 + rowIndex * 0.31;
        const radius = 8 + (slot % 4) * 6;
        const leftAnchor = rect.left - 28;
        const rightAnchor = rect.right + 18;
        const anchorX = leftAnchor > 18 ? leftAnchor : Math.min(width - 18, rightAnchor);
        const anchorY = rect.top + Math.min(rect.height * 0.42, 58) + (slot % 2) * 10;
        p.cluster = rowIndex;
        p.targetX = anchorX + Math.cos(angle) * radius;
        p.targetY = anchorY + Math.sin(angle) * radius;
      });
    }

    function placeReducedMotion() {
      assignClusterTargets();
      particles.forEach((p) => {
        if (p.cluster >= 0) {
          p.x = p.targetX;
          p.y = p.targetY;
        }
      });
      formed = hasEntries;
    }

    function updateFocus(now) {
      if (reducedQuery.matches) {
        focus.active = false;
        return;
      }

      if (coarseQuery.matches || !focus.active) {
        const t = now * 0.00008;
        focus.x = width * (0.5 + Math.sin(t * 1.9) * 0.28);
        focus.y = height * (0.42 + Math.cos(t * 1.35) * 0.22);
        focus.active = true;
      }
    }

    function updateParticles(now, delta) {
      const elapsed = now - condensationStartedAt;

      if (hasEntries && !condensationCaptured && elapsed >= 0) {
        particles.forEach((p) => {
          if (p.cluster >= 0) {
            p.startX = p.x;
            p.startY = p.y;
          }
        });
        condensationCaptured = true;
      }

      particles.forEach((p, index) => {
        if (hasEntries && p.cluster >= 0) {
          if (elapsed >= 0) {
            const progress = easeOut((elapsed - index * 8) / 600);
            if (progress > 0) {
              p.x = p.startX + (p.targetX - p.startX) * progress;
              p.y = p.startY + (p.targetY - p.startY) * progress;
            }
            if (progress >= 1) {
              formed = true;
              const breath = Math.sin(now * 0.0011 + p.driftPhase) * 1.5;
              p.x = p.targetX + Math.cos(p.driftPhase) * breath;
              p.y = p.targetY + Math.sin(p.driftPhase) * breath;
            }
            return;
          }
        }

        const noiseX = Math.sin(now * 0.00012 + p.seed) * 0.07;
        const noiseY = Math.cos(now * 0.0001 + p.seed) * 0.07;
        p.x += (p.vx + noiseX) * delta;
        p.y += (p.vy + noiseY) * delta;

        if (p.x < -12) p.x = width + 12;
        if (p.x > width + 12) p.x = -12;
        if (p.y < -12) p.y = height + 12;
        if (p.y > height + 12) p.y = -12;
      });
    }

    function drawSafelight() {
      const start = height * 0.85;
      const gradient = ctx.createLinearGradient(0, start, 0, height);
      gradient.addColorStop(0, `rgba(${safelight.r}, ${safelight.g}, ${safelight.b}, 0)`);
      gradient.addColorStop(1, `rgba(${safelight.r}, ${safelight.g}, ${safelight.b}, 0.04)`);
      ctx.fillStyle = gradient;
      ctx.fillRect(0, start, width, height - start);
    }

    function nearbyParticles(activePoints) {
      if (reducedQuery.matches || !focus.active) return [];
      return activePoints.filter((p) => Math.hypot(p.x - focus.x, p.y - focus.y) < focusRadius);
    }

    function buildGrid(activePoints) {
      const grid = new Map();
      activePoints.forEach((p) => {
        const key = `${Math.floor(p.x / gridSize)}:${Math.floor(p.y / gridSize)}`;
        const bucket = grid.get(key);
        if (bucket) bucket.push(p);
        else grid.set(key, [p]);
      });
      return grid;
    }

    function drawConnections(activePoints) {
      const near = nearbyParticles(activePoints);
      if (!near.length) return;

      const grid = buildGrid(activePoints);
      near.forEach((p) => {
        const cx = Math.floor(p.x / gridSize);
        const cy = Math.floor(p.y / gridSize);
        const nearest = [];

        for (let gx = cx - 2; gx <= cx + 2; gx += 1) {
          for (let gy = cy - 2; gy <= cy + 2; gy += 1) {
            const bucket = grid.get(`${gx}:${gy}`);
            if (!bucket) continue;
            bucket.forEach((candidate) => {
              if (candidate === p) return;
              const distance = Math.hypot(candidate.x - p.x, candidate.y - p.y);
              if (distance < neighborRadius) nearest.push({ p: candidate, distance });
            });
          }
        }

        nearest
          .sort((a, b) => a.distance - b.distance)
          .slice(0, 3)
          .forEach((candidate) => {
            const attention = 1 - Math.hypot(p.x - focus.x, p.y - focus.y) / focusRadius;
            const alpha = Math.min(0.25, Math.max(0, 1 - candidate.distance / neighborRadius) * attention * 0.2);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(candidate.p.x, candidate.p.y);
            ctx.strokeStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;
            ctx.lineWidth = 0.55;
            ctx.stroke();
          });
      });
    }

    function draw(now) {
      ctx.clearRect(0, 0, width, height);
      updateFocus(now);
      drawConnections(particles);

      particles.forEach((p, index) => {
        const nearFocus = focus.active ? Math.hypot(p.x - focus.x, p.y - focus.y) : Infinity;
        const attention = !reducedQuery.matches && nearFocus < focusRadius ? 1 - nearFocus / focusRadius : 0;
        const inCluster = p.cluster >= 0 && (formed || reducedQuery.matches);
        const alpha = Math.min(0.35, (hasEntries ? 0.14 : 0.11) + attention * 0.16 + (inCluster ? 0.07 : 0));
        const radius = inCluster ? 1.35 : index % 7 === 0 ? 1.45 : 1.05;
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;
        ctx.fill();
      });

      drawSafelight();
    }

    function frame(now) {
      if (!running || destroyed || !isPrint() || document.hidden) return;
      const delta = Math.min(32, now - (lastFrame || now));
      lastFrame = now;
      updateParticles(now, delta);
      draw(now);
      animationId = window.requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      window.cancelAnimationFrame(animationId);
      animationId = 0;
      lastFrame = 0;
      ctx.clearRect(0, 0, width, height);
    }

    function start() {
      window.cancelAnimationFrame(animationId);
      if (destroyed || !isPrint() || document.hidden) {
        stop();
        return;
      }
      if (!initialized) {
        resizeCanvas();
        initParticles();
        initialized = true;
      }
      if (reducedQuery.matches) {
        running = false;
        placeReducedMotion();
        draw(performance.now());
        return;
      }
      running = true;
      lastFrame = performance.now();
      animationId = window.requestAnimationFrame(frame);
    }

    function reflow() {
      if (!isPrint()) return;
      const previousCount = totalPoints;
      resizeCanvas();
      const next = particleCount();
      if (!initialized || next.count !== previousCount || next.rows.length !== (hasEntries ? new Set(particles.filter((p) => p.cluster >= 0).map((p) => p.cluster)).size : 0)) {
        initParticles();
      } else {
        assignClusterTargets();
      }
      if (reducedQuery.matches) {
        placeReducedMotion();
        draw(performance.now());
      }
    }

    function debouncedReflow() {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(reflow, resizeDelay);
    }

    function handleThemeChange() {
      if (isPrint()) start();
      else stop();
    }

    const observer = new MutationObserver(handleThemeChange);
    observer.observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    function handlePointerMove(event) {
      if (!isPrint() || coarseQuery.matches || reducedQuery.matches) return;
      focus.x = event.clientX;
      focus.y = event.clientY;
      focus.active = true;
    }

    function handlePointerLeave() {
      if (!coarseQuery.matches) focus.active = false;
    }

    function boot() {
      if (isPrint()) start();
    }

    window.addEventListener('resize', debouncedReflow);
    window.addEventListener('pointermove', handlePointerMove);
    window.addEventListener('pointerleave', handlePointerLeave);
    document.addEventListener('visibilitychange', handleThemeChange);
    document.addEventListener('astro:page-load', reflow);
    document.addEventListener('astro:after-swap', reflow);
    reducedQuery.addEventListener('change', start);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }

    window.__latentField = {
      destroy() {
        destroyed = true;
        stop();
        observer.disconnect();
        window.clearTimeout(resizeTimer);
        window.removeEventListener('resize', debouncedReflow);
        window.removeEventListener('pointermove', handlePointerMove);
        window.removeEventListener('pointerleave', handlePointerLeave);
        document.removeEventListener('visibilitychange', handleThemeChange);
        document.removeEventListener('astro:page-load', reflow);
        document.removeEventListener('astro:after-swap', reflow);
        document.removeEventListener('DOMContentLoaded', boot);
        reducedQuery.removeEventListener('change', start);
      },
    };
  })();
</script>
