---
interface Props {
  name: 'github' | 'linkedin' | 'x' | 'mail' | 'rss' | 'external' | 'toggle' | 'seal';
  title?: string;
  class?: string;
}

const { name, title, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  {
    name === 'github' && (
      <path d="M10 2.8c-4.3 0-7.8 3.5-7.8 7.8 0 3.4 2.2 6.3 5.3 7.4.4.1.5-.2.5-.4v-1.5c-2.2.5-2.6-.9-2.6-.9-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.8.9 2.3.7.1-.5.3-.9.5-1.1-1.7-.2-3.5-.9-3.5-3.9 0-.9.3-1.5.8-2.1-.1-.2-.3-1 .1-2.1 0 0 .7-.2 2.1.8.6-.2 1.2-.3 1.9-.3s1.3.1 1.9.3c1.5-1 2.1-.8 2.1-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.2.8 2.1 0 3-1.8 3.7-3.5 3.9.3.2.5.7.5 1.4v2.3c0 .2.1.5.5.4 3.1-1.1 5.3-4 5.3-7.4 0-4.3-3.5-7.8-7.8-7.8Z" />
    )
  }
  {
    name === 'linkedin' && (
      <>
        <path d="M5.1 8.3v8.6" />
        <path d="M5.1 5.2v.1" />
        <path d="M9 16.9V8.3" />
        <path d="M9 11.4c.7-2.1 5.8-2.7 5.8 1.9v3.6" />
        <path d="M2.7 16.9h14.6" />
      </>
    )
  }
  {
    name === 'x' && (
      <>
        <path d="m3.2 3.8 13.6 12.4" />
        <path d="M16.4 3.8 3.6 16.2" />
        <path d="M6 3.8h-2.8l10.8 12.4h2.8Z" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <path d="M3 5.2h14v9.6H3z" />
        <path d="m3 6 7 5 7-5" />
      </>
    )
  }
  {
    name === 'rss' && (
      <>
        <path d="M4.2 4.4c6.3 0 11.4 5.1 11.4 11.4" />
        <path d="M4.2 8.8a7 7 0 0 1 7 7" />
        <path d="M5.1 15.6h.1" />
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <path d="M7.2 4.2h8.6v8.6" />
        <path d="m15.8 4.2-11.6 11.6" />
        <path d="M6.4 8.6v7h7" />
      </>
    )
  }
  {
    name === 'toggle' && (
      <>
        <circle cx="10" cy="10" r="6.6" />
        <path d="M10 3.4a6.6 6.6 0 0 1 0 13.2Z" />
      </>
    )
  }
  {
    name === 'seal' && (
      <>
        <circle cx="10" cy="10" r="8" />
        <path d="M6.3 13.6V6.4l5.4 7.2V6.4" />
        <path d="M13.2 13.6V6.4h2.2c1.4 0 2.3.8 2.3 2s-.9 2-2.3 2h-2.2" />
        <path d="m15.2 10.4 2.2 3.2" />
      </>
    )
  }
</svg>
