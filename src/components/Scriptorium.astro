---
/**
 * Scriptorium — an interactive illuminated passage. The body text is laid out
 * on a <canvas> with @chenglou/pretext (no DOM reflow) and FLOWS AROUND a
 * curvy, glowing red line — a vertical sine wave that undulates down the column.
 * Move the cursor inside the passage and the wave drifts to follow it
 * horizontally; the text re-flows around it in real time. Scoped to this
 * section. Adapted to the dark blackwall aesthetic; works in paper mode too.
 */
---

<section class="scriptorium" aria-label="An illuminated passage">
  <div class="scriptorium__plate">
    <canvas class="ms-canvas" data-ms-canvas></canvas>
    <!-- accessible / SEO copy of the passage (the canvas is decorative) -->
    <p class="sr-only">
      Behind the Blackwall the old models still breathe — coiled in the margins, patient, waiting to
      be swapped in at 3 a.m. when the pager screams. Most of them are paint: convincing until you set
      a finger to the flank and feel how cold it is. The work is learning which ones are warm. I ship
      agents into production and publish what the evals actually say — the timestamp that turns a cache
      into a zero-per-cent hit, the coercion layer that holds when the model underneath you changes,
      the six gigabytes of VRAM that turn out to be enough. No demo that only runs once. No number the
      repository cannot reproduce. Only the honest weight of a thing observed from life rather than
      copied from a pattern book — and the quiet certainty, on the seventh night, that the ember in
      the margin was breathing all along.
    </p>
  </div>
  <p class="ms-credit">move your cursor through the passage</p>
</section>

<script>
  import { prepareWithSegments, layoutNextLine } from '@chenglou/pretext';

  const PASSAGE =
    'ehind the Blackwall the old models still breathe — coiled in the margins, patient, waiting to ' +
    'be swapped in at 3 a.m. when the pager screams. Most of them are paint: convincing until you ' +
    'set a finger to the flank and feel how cold it is. The work is learning which ones are warm. I ' +
    'ship agents into production and publish what the evals actually say — the timestamp that turns a ' +
    'cache into a zero-per-cent hit, the coercion layer that holds when the model underneath you ' +
    'changes, the six gigabytes of VRAM that turn out to be enough. No demo that only runs once. No ' +
    'number the repository cannot reproduce. Only the honest weight of a thing observed from life ' +
    'rather than copied from a pattern book — and the quiet certainty, on the seventh night, that the ' +
    'ember in the margin was breathing all along.';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ms-canvas]');
  if (canvas) start(canvas);

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const plate = canvas.parentElement!;

    let W = 0, H = 0, dpr = 1;
    let padX = 0, padY = 0, colL = 0, colR = 0, fontSize = 17, lineH = 27, capSize = 0, capW = 0, capH = 0;
    let amp = 48, freqK = 0.02, waveTop = 0, waveBot = 0, phase = 0;
    let prepared: ReturnType<typeof prepareWithSegments> | null = null;
    let fontStr = '';

    const rest = { x: 0 };
    const drag = { x: 0 };
    const mouse = { x: 0, y: 0 };
    let lastMove = -1e9, moved = false, inBox = false;
    const inTextBox = (x: number, y: number) =>
      x >= colL && x <= colR && y >= padY * 0.6 && y <= H - padY * 0.4;

    const resize = () => {
      const r = plate.getBoundingClientRect();
      W = Math.max(280, r.width); H = Math.max(260, r.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      padX = Math.max(28, W * 0.07); padY = Math.max(30, H * 0.09);
      colL = padX; colR = W - padX;
      fontSize = Math.max(15, Math.min(19, W / 34));
      lineH = Math.round(fontSize * 1.62);
      capSize = fontSize * 3.4; capH = capSize * 0.78; capW = capSize * 0.62;

      waveTop = padY * 0.8; waveBot = H - padY * 0.7;
      amp = Math.min(52, (colR - colL) * 0.12);
      freqK = (Math.PI * 2 * 2.2) / Math.max(1, waveBot - waveTop);

      fontStr = `${fontSize}px "Newsreader Variable", Georgia, serif`;
      prepared = prepareWithSegments(PASSAGE, fontStr);
      rest.x = colL + (colR - colL) * 0.5;
      if (!moved) drag.x = rest.x;
    };

    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      inBox = inTextBox(mouse.x, mouse.y);
      lastMove = performance.now(); moved = true;
    });
    canvas.addEventListener('pointerleave', () => { inBox = false; });

    // wave x at a given screen y (amplitude tapers to 0 at the ends)
    const env = (y: number) => {
      const t = Math.max(0, Math.min(1, (y - waveTop) / (waveBot - waveTop)));
      return Math.sin(Math.PI * t);
    };
    const waveX = (y: number) => drag.x + amp * env(y) * Math.sin(y * freqK + phase);

    // thin exclusion that snakes with the wave
    function exclusion(y0: number, y1: number): [number, number] | null {
      const mid = (y0 + y1) / 2;
      if (mid < waveTop || mid > waveBot) return null;
      const wx = waveX(mid), hw = 15;
      return [wx - hw, wx + hw];
    }

    function render(now: number) {
      if (!prepared) return;
      phase = now * 0.0008; // continuous, gentle travel = "moving"
      const cs = getComputedStyle(document.documentElement);
      const ink = cs.getPropertyValue('--text').trim() || '#c3ced6';
      const accent = cs.getPropertyValue('--accent').trim() || '#a8173a';

      ctx.clearRect(0, 0, W, H);
      ctx.textBaseline = 'alphabetic';
      ctx.font = fontStr;

      const capLines = capH / lineH;
      let cursor = { segmentIndex: 0, graphemeIndex: 0 };
      let y = padY + fontSize;
      let lineIdx = 0, guard = 0;
      const total = (prepared as any).widths?.length ?? 1e9;

      while (cursor.segmentIndex < total && y < H - padY * 0.4 && guard++ < 400) {
        const bandTop = y - fontSize, bandBot = y + (lineH - fontSize);
        const indentL = lineIdx < capLines ? colL + capW : colL;

        const ex = exclusion(bandTop, bandBot);
        let ranges: [number, number][] = [[indentL, colR]];
        if (ex) {
          const [ax, bx] = ex;
          ranges = [];
          if (ax - indentL > fontSize * 2) ranges.push([indentL, ax]);
          if (colR - bx > fontSize * 2) ranges.push([bx, colR]);
          if (!ranges.length) ranges.push([Math.max(indentL, bx), colR]);
        }

        for (const [rx0, rx1] of ranges) {
          const w = rx1 - rx0;
          if (w < fontSize * 2) continue;
          const line = layoutNextLine(prepared, cursor, w);
          if (!line || line.text.length === 0) continue;
          const txt = line.text.replace(/\s+$/, '');
          ctx.fillStyle = ink;
          ctx.fillText(txt, rx0, y);
          cursor = { ...line.end };
        }
        y += lineH; lineIdx++;
      }

      // illuminated drop-cap
      ctx.font = `600 ${capSize}px "Newsreader Variable", Georgia, serif`;
      ctx.fillStyle = accent;
      ctx.shadowColor = accent; ctx.shadowBlur = 22;
      ctx.fillText('B', colL - 2, padY + capH * 0.82);
      ctx.shadowBlur = 0;
      ctx.font = fontStr;

      // the curvy glowing line
      const trace = () => {
        ctx.beginPath();
        let started = false;
        for (let yy = waveTop; yy <= waveBot; yy += 4) {
          const x = waveX(yy);
          if (!started) { ctx.moveTo(x, yy); started = true; } else ctx.lineTo(x, yy);
        }
      };
      ctx.save();
      ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      ctx.shadowColor = accent; ctx.shadowBlur = 16;
      ctx.strokeStyle = accent; ctx.lineWidth = 3.4; trace(); ctx.stroke();
      ctx.shadowBlur = 7;
      ctx.strokeStyle = 'rgba(255,184,200,0.6)'; ctx.lineWidth = 1.3; trace(); ctx.stroke();
      ctx.restore();
    }

    // continuous loop (the wave is always moving), paused when off-screen / hidden
    let raf = 0, running = false, onScreen = true;
    const loop = (now: number) => {
      if (!onScreen || document.hidden) { running = false; return; }
      const idle = now - lastMove > 1800;
      const chase = moved && !idle && inBox; // only follow inside the text box
      const tx = chase ? mouse.x : rest.x;
      drag.x += (tx - drag.x) * 0.085;
      render(now);
      raf = requestAnimationFrame(loop);
    };
    const ensure = () => { if (!running) { running = true; raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; if (onScreen) ensure(); }, { threshold: 0 }).observe(plate);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) ensure(); });

    const boot = () => { resize(); ensure(); };
    if ((document as any).fonts?.ready) (document as any).fonts.ready.then(boot);
    else boot();
    new ResizeObserver(() => resize()).observe(plate);
  }
</script>
