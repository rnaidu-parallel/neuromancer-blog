---
/**
 * Blackwall — the site's reactive background.
 *
 * A reactive WebGL "black ICE" membrane fixed behind the whole screen:
 * a dark, breathing, domain-warped field laced with blood-red fracture veins
 * that flare toward the cursor — the wall holding the rogue AIs back.
 *
 * Progressive enhancement, by design:
 *   - the CSS gradient fallback (.blackwall__fallback) paints instantly, 0 JS
 *   - the <canvas> shader is initialised AFTER first paint, only when WebGL is
 *     available and the user hasn't asked for reduced motion
 *   - on failure / opt-out / hidden tab / scrolled-out-of-view, the static
 *     fallback simply stays — nothing blocks render, nothing burns battery
 *
 * Raw WebGL on purpose: one full-screen fragment shader needs no library.
 */
---

<div class="blackwall" aria-hidden="true">
  <div class="blackwall__fallback"></div>
  <canvas class="blackwall__canvas" data-blackwall></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-blackwall]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: true, premultipliedAlpha: false });
    if (gl) initBlackwall(canvas, gl);
  }

  function initBlackwall(canvas: HTMLCanvasElement, gl: WebGLRenderingContext) {
    const VERT = `
      attribute vec2 a_pos;
      void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
    `;

    // Domain-warped fbm membrane + blood-red fracture veins + cursor heat.
    const FRAG = `
      precision highp float;
      uniform float u_time;
      uniform vec2  u_res;
      uniform vec2  u_mouse;   // 0..1, y up
      uniform float u_intro;   // 0..1 fade-in ramp
      uniform float u_press;   // 0..1 cursor proximity energy
      uniform float u_reveal;  // 0..1 name typewriter progress
      uniform float u_calm;    // 0 at the top -> 1 scrolled into content
      uniform float u_burst;   // 1 on an action (name lands / uplink opens), decays
      uniform vec2  u_burstO;  // 0..1 origin the burst emanates from

      float hash(vec2 p){
        p = fract(p * vec2(123.34, 345.45));
        p += dot(p, p + 34.345);
        return fract(p.x * p.y);
      }
      float noise(vec2 p){
        vec2 i = floor(p); vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0.0, a = 0.5;
        mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
        for (int i = 0; i < 5; i++) { v += a * noise(p); p = m * p; a *= 0.5; }
        return v;
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p  = uv;
        p.x *= u_res.x / u_res.y;            // aspect-correct
        float t = u_time * 0.04;

        // the whole red pattern swells & churns while the name types, then
        // settles back — driven by typewriter progress, NOT a moving line
        float env = u_reveal * (1.0 - u_reveal) * 4.0;   // 0 -> 1 -> 0 over the reveal
        t += env * 0.13 + u_burst * 0.35;                // bursts violently churn the field

        // two-step domain warp -> turbulent vertical membrane
        vec2 q = vec2(fbm(p * 2.6 + vec2(0.0, t)),
                      fbm(p * 2.6 + vec2(5.2, 1.3) - t));
        vec2 r = vec2(fbm(p * 2.6 + 2.0 * q + vec2(1.7, 9.2) + t * 0.5),
                      fbm(p * 2.6 + 2.0 * q + vec2(8.3, 2.8)));
        float f = fbm(p * 2.6 + 3.4 * r);

        // cursor heat — the wall pressed from the other side
        vec2 m = u_mouse; m.x *= u_res.x / u_res.y;
        float heat = exp(-distance(p, m) * 3.2) * u_press;
        f += heat * 0.30;

        vec3 bg  = vec3(0.039, 0.055, 0.071);   // #0a0e12
        vec3 col = bg;

        // fade the veins back as the reader scrolls into content, so the
        // pattern stays dramatic at the hero but never fights body text
        float vis = mix(1.0, 0.30, u_calm);

        // cold steel sheen in the deeper folds
        col += vec3(0.016, 0.038, 0.055) * smoothstep(0.25, 0.95, f);

        // low-frequency zoning: large calm "black wall" stretches between
        // active regions, so the veins read as sparse cracks, not lava
        float zone = smoothstep(0.30, 0.62, fbm(p * 0.85 + vec2(t * 0.3, -t * 0.2)));
        float charge = mix(0.18, 1.0, zone);

        // fracture veins: a thin bright ridge where the field crosses 0.5,
        // brightening across the whole field as the name reveal swells
        float vein  = abs(f - 0.5);
        float crack = smoothstep(0.040, 0.0, vein);
        vec3  accent = vec3(0.66, 0.09, 0.23);  // #a8173a
        col += accent * crack * charge * (0.5 + heat * 2.0 + env * 1.7) * vis;
        col += accent * smoothstep(0.12, 0.0, vein) * charge * (0.055 + env * 0.05) * vis;

        // action burst — a shockwave ring + flare erupting from the origin
        // (the name as it lands, the uplink as it opens). Ignores the calm
        // fade so an action always reads dramatically, even mid-page.
        if (u_burst > 0.001) {
          vec2 bo = u_burstO; bo.x *= u_res.x / u_res.y;
          float bd     = distance(p, bo);
          float radius = (1.0 - u_burst) * 1.6;                 // ring expands as it decays
          float ring   = smoothstep(0.14, 0.0, abs(bd - radius)) * u_burst;
          col += accent * ring * 2.8;                           // the shockwave
          col += accent * exp(-bd * 2.2) * u_burst * 1.5;       // core flare
          col += accent * crack * charge * u_burst * 2.2;       // every vein blazes
          col += accent * u_burst * u_burst * 0.12;             // whole-field red wash
        }

        // CRT echo + edge vignette so the canvas melts into the page
        col *= 0.93 + 0.07 * sin(gl_FragCoord.y * 0.7);
        float vig = smoothstep(1.15, 0.15, length(uv - 0.5));
        col = mix(bg, col, vig);

        gl_FragColor = vec4(col, vig * u_intro);
      }
    `;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return; // bail -> fallback stays
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const u = {
      time: gl.getUniformLocation(prog, 'u_time'),
      res: gl.getUniformLocation(prog, 'u_res'),
      mouse: gl.getUniformLocation(prog, 'u_mouse'),
      intro: gl.getUniformLocation(prog, 'u_intro'),
      press: gl.getUniformLocation(prog, 'u_press'),
      reveal: gl.getUniformLocation(prog, 'u_reveal'),
      calm: gl.getUniformLocation(prog, 'u_calm'),
      burst: gl.getUniformLocation(prog, 'u_burst'),
      burstO: gl.getUniformLocation(prog, 'u_burstO'),
    };

    // action bursts — any page can fire `blackwall:burst` (with a normalised
    // {x, y} origin) and the field erupts from that point, then decays
    let burst = 0, bx = 0.5, by = 0.55;
    window.addEventListener('blackwall:burst', (e: Event) => {
      const d = (e as CustomEvent).detail;
      if (d && typeof d.x === 'number') { bx = d.x; by = d.y; }
      burst = 1;
      loop();
    });

    // sync the reveal sweep to the hero typewriter: it's gated on fonts being
    // ready, then runs 0.3s-delay + 1.7s — mirror that timing here
    let revealStart: number | null = null;
    const beginReveal = () => { if (revealStart === null) revealStart = performance.now(); };
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(beginReveal);
    else beginReveal();

    // pointer state (eased toward the target for a heavier, fluid feel)
    let mx = 0.5, my = 0.55, tmx = 0.5, tmy = 0.55, press = 0, tpress = 0;
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      tmx = (e.clientX - r.left) / r.width;
      tmy = 1.0 - (e.clientY - r.top) / r.height;
      tpress = 1.0;
    };
    const onLeave = () => { tpress = 0; };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onMove, { passive: true });
    window.addEventListener('pointerleave', onLeave);

    let dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5); // cap for fill-rate
      // size from the viewport, not clientWidth — the canvas is fixed/full-bleed,
      // so this stays correct even when CSS has it display:none (paper mode) and
      // avoids a 1x1 "stretch flash" on the way back to dark
      const w = window.innerWidth, h = window.innerHeight;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    new ResizeObserver(resize).observe(canvas);
    resize();

    // The loop always runs while the tab is visible; in paper mode the canvas
    // is hidden by CSS (drawing a 1x1 hidden buffer is ~free), and on the way
    // back to dark the ResizeObserver restores its size — so there's no
    // pause/resume state to get stuck and the switch is always reliable.
    const start = performance.now();
    let intro = 0, raf = 0, running = false;
    const loop = () => {
      if (running) return;
      running = true;
      const frame = (now: number) => {
        if (document.hidden) { running = false; return; }
        // paper mode: keep the loop alive but skip the draw (no GPU cost, and
        // nothing to resume — switching back to dark just paints the next frame)
        if (document.documentElement.dataset.theme === 'light') {
          raf = requestAnimationFrame(frame);
          return;
        }
        const t = (now - start) / 1000;
        intro = Math.min(1, intro + 0.02);
        mx += (tmx - mx) * 0.06; my += (tmy - my) * 0.06;
        press += (tpress - press) * 0.05;
        burst *= 0.955;
        if (burst < 0.002) burst = 0;
        const reveal = revealStart === null
          ? 0
          : Math.min(1, Math.max(0, (now - revealStart - 300) / 1700));
        const calm = Math.min(1, window.scrollY / (window.innerHeight * 0.8));
        gl.uniform1f(u.time, t);
        gl.uniform2f(u.res, canvas.width, canvas.height);
        gl.uniform2f(u.mouse, mx, my);
        gl.uniform1f(u.intro, intro);
        gl.uniform1f(u.press, press);
        gl.uniform1f(u.reveal, reveal);
        gl.uniform1f(u.calm, calm);
        gl.uniform1f(u.burst, burst);
        gl.uniform2f(u.burstO, bx, by);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    };
    document.addEventListener('visibilitychange', () => { if (!document.hidden) loop(); });
    loop();

    // mark ready so the static fallback can fade out from under the canvas
    canvas.classList.add('is-live');
  }
</script>
