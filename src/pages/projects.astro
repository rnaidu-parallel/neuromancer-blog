---
import Base from '../layouts/Base.astro';
import { renderPlateSvg } from '../lib/plates';

// Each card = one public concept repo. Cards link to the repo once it's
// public; until then they render as non-links. New entries land here the
// day the repo goes live.
const projects = [
  {
    title: 'ai-usage-heatmap',
    desc: 'A GitHub-style heatmap of your AI token usage, on your GitHub profile. One npx command turns a tokscale or ccusage export into a stats card with daily totals and agent icons, committed to your own repo. No server, no signup, zero dependencies; your usage data never leaves your machine.',
    href: 'https://github.com/rnaidu-parallel/ai-usage-heatmap',
  },
  {
    title: 'neuromancer-mcp',
    desc: 'Most hiring tooling makes a candidate\'s agent apply or a recruiter\'s agent screen. This flips it: my résumé is a remote MCP server a company\'s agent connects to with one command, to read my work, weigh it against a role, and reach out. Eight tools over Streamable HTTP, inbound-only contact, built to be forked by swapping a single file.',
    href: 'https://github.com/rnaidu-parallel/neuromancer-mcp',
  },
  {
    title: 'hermes-local-agent',
    desc: 'A personal AI agent running entirely on a 2018 gaming laptop with 6GB of VRAM: Hermes + Ollama + qwen3.5, driven from Telegram. Five measured budget constraints decide a local agent stack, and the KV cache, not parameter count, is the real bottleneck. Blog-only build, every number measured on the laptop.',
    href: 'https://blog.neuromancer.in/blog/6gb-vram-local-agent/',
  },
  {
    title: 'prompt-cache-economics',
    desc: 'A timestamp at the top of your prompt is a 0% cache hit on OpenAI, and on Anthropic it costs more than not caching at all. This repo measures prompt-cache economics across providers, with a recorded benchmark and an interactive replay you can step through.',
    href: 'https://github.com/rnaidu-parallel/prompt-cache-economics',
  },
  {
    title: 'agent-coercion-layer',
    desc: 'Swap models in a production agent and their output shapes differ: one fences its JSON, one truncates a tool call at a nullable field. This repo measures what differs across models, and ships a transparent coercion layer that absorbs it.',
    href: 'https://github.com/rnaidu-parallel/agent-coercion-layer',
  },
];
---

<Base
  title="Projects · Rahul Naidu"
  description="Public concept repos: production LLM lessons, each backed by a reproducible eval."
  wide
>
  <header class="register-header reveal">
    <p class="section-heading">APPARATUS</p>
    <h1>Projects</h1>
    <p class="post-desc">What I'm building in public.</p>
  </header>

  <div class="apparatus-list reveal">
    {
      projects.map((p, index) =>
        p.href ? (
          <a class="apparatus-entry" href={p.href} style={`--i: ${index + 2}`}>
            <div class="apparatus-plate">
              <div
                class="plate"
                set:html={renderPlateSvg(p.title, { title: `Cyanotype apparatus plate for ${p.title}` })}
              />
              <p class="caption">
                <span class="fig-label">App. {String(index + 1).padStart(2, '0')}</span>
                <span> · {p.title}</span>
              </p>
            </div>
            <div class="apparatus-body">
              <p class="entry-kicker">PUBLIC RECORD</p>
              <h2>{p.title}</h2>
              <p>{p.desc}</p>
              <span class="apparatus-link">open record</span>
            </div>
          </a>
        ) : (
          <div class="apparatus-entry" style={`--i: ${index + 2}`}>
            <div class="apparatus-plate">
              <div
                class="plate"
                set:html={renderPlateSvg(p.title, { title: `Cyanotype apparatus plate for ${p.title}` })}
              />
              <p class="caption">
                <span class="fig-label">App. {String(index + 1).padStart(2, '0')}</span>
                <span> · {p.title}</span>
              </p>
            </div>
            <div class="apparatus-body">
              <p class="entry-kicker">PUBLIC RECORD</p>
              <h2>{p.title}</h2>
              <p>{p.desc}</p>
            </div>
          </div>
        )
      )
    }
  </div>
</Base>
