---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Scriptorium from '../components/Scriptorium.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<Base
  title="blackwall — Rahul Naidu Siriporam, AI engineer"
  description="AI engineer leading tech at OneStop AI, building Jarvis, an agentic AI investing platform on WhatsApp, web, and mobile. I ship agents to production and publish the evidence."
>
  <section class="hero">
    <div class="hero__body">
      <h1 class="reveal"><span class="typed">Rahul Naidu Siriporam</span><span class="cursor" aria-hidden="true"></span></h1>
      <p class="tagline reveal">
        AI engineer. I ship agents to production and <strong>publish the evidence</strong>.
      </p>
      <p class="hero-bio reveal">
        Leading tech and engineering at <strong>OneStop AI</strong>, where I architect and own
        <strong>Jarvis/IRA</strong> end to end: an agentic AI investing platform on WhatsApp, web,
        and iOS/Android (the <code>One-Stop-AI/osai_jango</code> repo). Before that I led three
        engineers at Canvas AI on SugarFit's diabetes-care assistant, and was on Apperture's
        founding team at Parallel.
      </p>
      <p class="hero-aside reveal">// just another net runner wandering the streets of night city</p>
      <p class="hero-meta reveal">
        agents · context engineering · rag · tool-calling reliability · evals · prompt caching ·
        model routing · agent memory
      </p>
    </div>
  </section>

  <h2 class="rule rule--tight" aria-label="Jarvis">jarvis</h2>
  <aside class="jarvis">
    <p class="jarvis-intro">
      <strong>Jarvis</strong> is an agentic AI investing companion I build at OneStop AI. It
      lives where you already are: WhatsApp, the web, and iOS/Android. Ask it about a stock,
      hand it your portfolio as a CSV, image, or PDF, and it remembers you across sessions.
    </p>
