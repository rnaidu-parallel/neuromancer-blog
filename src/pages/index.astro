---
import { getCollection } from 'astro:content';
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .slice()
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Rahul Naidu · AI engineering journal"
  description="A journal of measured work in AI engineering: production lessons, reproducible evals, real failure modes, and honest tradeoffs."
  masthead="home"
  wide
>
  <EntryList posts={posts} allPosts={allPosts} />
</Base>
